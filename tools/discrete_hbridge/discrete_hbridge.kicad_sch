	(text "R_{SENSE}:\n- V = IR = 1.5*0.02 = 0.03V\n- P = I^{2}R = 1.5*0.025 = 0.045W\n- 0.045W < 0.062W = 0402 MINIMUM (selected 0603)\n\nN-FET V_{GS}\n- V_{GS} = 3.3-0.03 = 3.27V\n\nPEAK VOLTAGE:\n- 1.5A: 0.03*50 = 1.5V\n\nPEAK CURRENT:\n- 3.3/50 = 0.066\n- 0.066/0.02 = 3.3A"
		(exclude_from_sim no)
